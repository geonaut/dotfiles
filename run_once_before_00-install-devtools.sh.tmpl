{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

echo "--------------------------------------------------------"
echo "🛠  Checking Xcode Command Line Tools ..."
echo "--------------------------------------------------------"

have_devtools() {
    local dev
    dev="$(xcode-select --print-path 2>/dev/null)" || return 1
    [ -n "$dev" ] && [ -d "$dev" ] && /usr/bin/xcrun --find git >/dev/null 2>&1
}

if have_devtools; then
    echo "✅ Command Line Tools present: $(xcode-select --print-path)"
    exit 0
fi

echo "⏳ Not found."
echo "   On a fresh macOS install /usr/bin/git is only a stub, so anything that"
echo "   shells out to git or a compiler (brew, mise, cargo) fails with:"
echo "     xcrun: error: invalid active developer path"
echo
echo "Requesting installation ..."

xcode-select --install >/dev/null 2>&1 || true

echo "A macOS dialog should have opened — click Install and accept the licence."
echo "Waiting for it to finish (up to 30 minutes) ..."

deadline=$(( SECONDS + 1800 ))
last_beat=$SECONDS
while [ "$SECONDS" -lt "$deadline" ]; do
    if have_devtools; then
        echo "✅ Command Line Tools installed: $(xcode-select --print-path)"
        exit 0
    fi
    if [ $(( SECONDS - last_beat )) -ge 60 ]; then
        echo "   ... still waiting ($(( (deadline - SECONDS) / 60 )) min remaining)"
        last_beat=$SECONDS
    fi
    sleep 10
done

echo "❌ Timed out waiting for the Command Line Tools."
echo "   Install them manually, then re-run: chezmoi apply"
echo "     xcode-select --install"
exit 1
{{ end -}}
