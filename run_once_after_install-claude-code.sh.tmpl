{{ if and (eq .chezmoi.os "darwin") .using_claude -}}
#!/bin/bash
set -euo pipefail

echo "--------------------------------------------------------"
echo "🤖 Checking Claude Code ..."
echo "--------------------------------------------------------"

if command -v claude >/dev/null 2>&1; then
    echo "✅ Claude Code present: $(command -v claude)"
    exit 0
fi

# Deliberately the native installer, not `brew install --cask claude-code`.
# Claude Code updates itself, so Homebrew's record goes stale the first time it
# does (the cask is flagged auto_updates, so `brew upgrade` skips it) and you end
# up with a duplicate copy under the Caskroom.
echo "🚀 Installing Claude Code via the native installer ..."
if curl -fsSL https://claude.ai/install.sh | bash; then
    echo "✅ Claude Code installed. It self-updates from here."
    echo "   Run 'claude' and sign in — credentials live in the macOS Keychain"
    echo "   and are per-machine, so they do not transfer."
else
    echo "⚠️  Claude Code install failed; continuing." >&2
fi

exit 0
{{ end -}}
